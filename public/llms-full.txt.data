n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 立即打印六数字 [#立即打印六数字]\n\n<Opcode id=\"0309\" name=\"PRINT_WITH_6_NUMBERS_NOW\">\n  PRINT\\_WITH\\_6\\_NUMBERS\\_NOW。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0309 PRINT_WITH_6_NUMBERS_NOW\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      printWith6NumbersNow()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"PRINT_WITH_6_NUMBERS_NOW\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 即将打印六数字 [#即将打印六数字]\n\n<Opcode id=\"030A\" name=\"PRINT_WITH_6_NUMBERS_SOON\">\n  PRINT\\_WITH\\_6\\_NUMBERS\\_SOON。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      030A PRINT_WITH_6_NUMBERS_SOON\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      printWith6NumbersSoon()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"PRINT_WITH_6_NUMBERS_SOON\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 人物编队跟随人物 [#人物编队跟随人物]\n\n<Opcode id=\"030B\" name=\"SET_CHAR_OBJ_FOLLOW_CHAR_IN_FORMATION\">\n  SET\\_CHAR\\_OBJ\\_FOLLOW\\_CHAR\\_IN\\_FORMATION。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <Co