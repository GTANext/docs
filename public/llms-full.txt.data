CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 标记关卡间行人路 [#标记关卡间行人路]\n\n<Opcode id=\"0427\" name=\"MARK_PED_ROADS_BETWEEN_LEVELS\">\n  MARK\\_PED\\_ROADS\\_BETWEEN\\_LEVELS。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0427 MARK_PED_ROADS_BETWEEN_LEVELS\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      markPedRoadsBetweenLevels()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"MARK_PED_ROADS_BETWEEN_LEVELS\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 人物避开关卡切换 [#人物避开关卡切换]\n\n<Opcode id=\"0429\" name=\"SET_CHAR_AVOID_LEVEL_TRANSITIONS\">\n  SET\\_CHAR\\_AVOID\\_LEVEL\\_TRANSITIONS。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0429 SET_CHAR_AVOID_LEVEL_TRANSITIONS\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      setCharAvoidLevelTransitions()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SET_CHAR_AVOID_LEVEL_TRANSITIONS\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 是否行人类型威胁 [#是否行人类型威胁]\n\n<Opcode id=\"042A\" name=\"IS_THREAT_FOR_PED_TYPE\">\n  IS\\_THREAT\\_FOR\\_PED\\_TYPE。\n\n  <CodeBlockTabs defaul