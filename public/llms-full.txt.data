   ```js\n      native(\"SET_ZONE_PED_INFO\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 车在空中 [#车在空中]\n\n<Opcode id=\"015E\" name=\"IS_CAR_IN_AIR\">\n  IS\\_CAR\\_IN\\_AIR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      015E IS_CAR_IN_AIR\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      isCarInAir()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"IS_CAR_IN_AIR\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 旧版人物标记 [#旧版人物标记]\n\n<Opcode id=\"0162\" name=\"ADD_BLIP_FOR_CHAR_OLD\">\n  ADD\\_BLIP\\_FOR\\_CHAR\\_OLD。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0162 ADD_BLIP_FOR_CHAR_OLD\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      addBlipForCharOld()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"ADD_BLIP_FOR_CHAR_OLD\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 旧版物体标记 [#旧版物体标记]\n\n<Opcode id=\"0163\" name=\"ADD_BLIP_FOR_OBJECT_OLD\">\n  ADD\\_BLIP\\_FOR\\_OBJECT\\_OLD。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n  