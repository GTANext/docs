ab value=\"OP\">\n      ```text\n      01D2 SET_CHAR_OBJ_GOTO_PLAYER_ON_FOOT\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      setCharObjGotoPlayerOnFoot()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SET_CHAR_OBJ_GOTO_PLAYER_ON_FOOT\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 人物下车 [#人物下车]\n\n<Opcode id=\"01D3\" name=\"SET_CHAR_OBJ_LEAVE_CAR\">\n  SET\\_CHAR\\_OBJ\\_LEAVE\\_CAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      01D3 SET_CHAR_OBJ_LEAVE_CAR\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      setCharObjLeaveCar()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SET_CHAR_OBJ_LEAVE_CAR\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 人物上车当乘客 [#人物上车当乘客]\n\n<Opcode id=\"01D4\" name=\"SET_CHAR_OBJ_ENTER_CAR_AS_PASSENGER\">\n  SET\\_CHAR\\_OBJ\\_ENTER\\_CAR\\_AS\\_PASSENGER。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      01D4 SET_CHAR_OBJ_ENTER_CAR_AS_PASSENGER\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      setCharObjEnterCarAsPassenger()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SET_CHAR_OBJ_ENTER_CAR_AS_PASSENGER\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 人物上车当司机 [#人物上车当司机]\n\n<Opcode id=\"01D5\" name=\"SET_CHAR_OBJ_ENTER_CAR_AS_DRIVER\">\n  SET\\_CHAR\\_OBJ\\_ENTER\\_CAR\\_AS\\_DRIVER。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      01D5 SET_CHAR_OBJ_ENTER_CAR_AS_DRIVER\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      setCharObjEnterCarAsDriver()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SET_CHAR_OBJ_ENTER_CAR_AS_DRIVER\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 人物车内跟车 [#人物车内跟车]\n\n<Opcode id=\"01D6\" name=\"SET_CHAR_OBJ_FOLLOW_CAR_IN_CAR\">\n  SET\\_CHAR\\_OBJ\\_FOLLOW\\_CAR\\_IN\\_CAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      01D6 SET_CHAR_OBJ_FOLLOW_CAR_IN_CAR\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      setCharObjFollowCarInCar()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SET_CHAR_OBJ_FOLLOW_CAR_IN_CAR\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 人物车内