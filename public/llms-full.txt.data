ockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"GET_CHASE_CAR\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 开始船泡沫动画 [#开始船泡沫动画]\n\n<Opcode id=\"043A\" name=\"START_BOAT_FOAM_ANIMATION\">\n  START\\_BOAT\\_FOAM\\_ANIMATION。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      043A START_BOAT_FOAM_ANIMATION\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      startBoatFoamAnimation()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"START_BOAT_FOAM_ANIMATION\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 更新船泡沫动画 [#更新船泡沫动画]\n\n<Opcode id=\"043B\" name=\"UPDATE_BOAT_FOAM_ANIMATION\">\n  UPDATE\\_BOAT\\_FOAM\\_ANIMATION。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      043B UPDATE_BOAT_FOAM_ANIMATION\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      updateBoatFoamAnimation()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"UPDATE_BOAT_FOAM_ANIMATION\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 设开场播放中 [#设开场播放中]\n\n<Opcode id=\"043D\" name=\"SET_INTRO_IS_PLAYING\">\n  SET\\_INTR