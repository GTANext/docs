n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"IS_INT_LVAR_NOT_EQUAL_TO_NUMBER\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 整 VAR 不等于整 VAR [#整-var-不等于整-var]\n\n<Opcode id=\"003F\" name=\"IS_INT_VAR_NOT_EQUAL_TO_INT_VAR\">\n  用在 if：int VAR 是否不等于另一 int VAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      003F IS_INT_VAR_NOT_EQUAL_TO_INT_VAR\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      isIntVarNotEqualToIntVar()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"IS_INT_VAR_NOT_EQUAL_TO_INT_VAR\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 整 LVAR 不等于整 LVAR [#整-lvar-不等于整-lvar]\n\n<Opcode id=\"0040\" name=\"IS_INT_LVAR_NOT_EQUAL_TO_INT_LVAR\">\n  用在 if：int LVAR 是否不等于另一 int LVAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0040 IS_INT_LVAR_NOT_EQUAL_TO_INT_LVAR\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      isIntLvarNotEqualToIntLvar()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"IS_INT_LVAR_NOT_EQUAL_TO_INT_LVAR\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 整 VAR 不等于整 LVAR [#整-var-不等于整-lvar]\n\n<Opcode id=\"0041\" name=\"IS_INT_VAR_NOT_EQUAL_TO_INT_LVAR\">\n  用在 if：int VAR 是否不等于 int LVAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0041 IS_INT_VAR_NOT_EQUAL_TO_INT_LVAR\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      isIntVarNotEqualToIntLvar()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"IS_INT_VAR_NOT_EQUAL_TO_INT_LVAR\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 浮 VAR 等于数 [#浮-var-等于数]\n\n<Opcode id=\"0042\" name=\"IS_FLOAT_VAR_EQUAL_TO_NUMBER\">\n  用在 if：float VAR 是否等于该值。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0042 IS_FLOAT_VAR_EQUAL_TO_NUMBER\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      isFloatVarEqualToNumber(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"IS_FLOAT_VAR_EQUAL_TO_NUMBER\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 浮 LVAR 等于数 [#浮-lvar-等于数]\n\n<Opcode id=\"0043\" name=\"IS_FLOAT_LVAR_EQUAL_TO_NUMBER\">\n  用在 if：float LVAR 是否等于该值。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0043 IS_FLOAT_LVAR_EQUAL_TO_NUMBER\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      isFloatLvarEqualToNumber(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"IS_FLOAT_LVAR_EQUAL_TO_NUMBER\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 浮 VAR 等于浮 VAR [#浮-var-等于浮-var]\n\n<Opcode id=\"0044\" name=\"IS_FLOAT_VAR_EQUAL_TO_FLOAT_VAR\">\n  用在 if：float VAR 是否等于另一 float VAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0044 IS_FLOAT_VAR_EQUAL_TO_FLOAT_VAR\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      isFloatVarEqualToFloatVar(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"IS_FLOAT_VAR_EQUAL_TO_FLOAT_VAR\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 浮 LVAR 等于浮 LVAR [#浮-lvar-等于浮-lvar]\n\n<Opcode id=\"0045\" name=\"IS_FLOAT_LVAR_EQUAL_TO_FLOAT_LVAR\">\n  用在 if：float LVAR 是否等于另一 float LVAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0045 IS_FLOAT_LVAR_EQUAL_TO_FLOAT_LVAR\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      isFloatLvarEqualToFloatLvar(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"IS_FLOAT_LVAR_EQUAL_TO_FLOAT_LVAR\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 浮 VAR 等于浮 LVAR [#浮-var-等于浮-lvar]\n\n<Opcode id=\"0046\" name=\"IS_FLOAT_VAR_EQUAL_TO_FLOAT_LVAR\">\n  用在 if：float VAR 是否等于 float LVAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0046 IS_FLOAT_VAR_EQUAL_TO_FLOAT_LVAR\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      isFloatVarEqualToFloatLvar(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"IS_FLOAT_VAR_EQUAL_TO_FLOAT_LVAR\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 浮 VAR 不等于数 [#浮-var-不等于数]\n\n<Opcode id=\"0047\" name=\"IS_FLOAT_VAR_NOT_EQUAL_TO_NUMBER\">\n  用在 if：float VAR 是否不等于数。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0047 IS_FLOAT_VAR_NOT_EQUAL_TO_NUMBER\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      isFloatVarNotEqualToNumber()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"IS_FLOAT_VAR_NOT_EQUAL_TO_NUMBER\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 浮 LVAR 不等于数 [#浮-lvar-不等于数]\n\n<Opcode id=\"0048\" name=\"IS_FLOAT_LVAR_NOT_EQUAL_TO_NUMBER\">\n  用在 if：float LVAR 是否不等于数。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0048 IS_FLOAT_LVAR_NOT_EQUAL_TO_NUMBER\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      isFloatLvarNotEqualToNumber()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"IS_FLOAT_LVAR_NOT_EQUAL_TO_NUMBER\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 浮 VAR 不等于浮 VAR [#浮-var-不等于浮-var]\n\n<Opcode id=\"0049\" name=\"IS_FLOAT_VAR_NOT_EQUAL_TO_FLOAT_VAR\">\n  用在 if：float VAR 是否不等于另一 float VAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0049 IS_FLOAT_VAR_NOT_EQUAL_TO_FLOAT_VAR\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      isFloatVarNotEqualToFloatVar()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"IS_FLOAT_VAR_NOT_EQUAL_TO_FLOAT_VAR\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 浮 LVAR 不等于浮 LVAR [#浮-lvar-不等于浮-lvar]\n\n<Opcode id=\"004A\" name=\"IS_FLOAT_LVAR_NOT_EQUAL_TO_FLOAT_LVAR\">\n  用在 if：float LVAR 是否不等于另一 float LVAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      004A IS_FLOAT_LVAR_NOT_EQUAL_TO_FLOAT_LVAR\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      isFloatLvarNotEqualToFloatLvar()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"IS_FLOAT_LVAR_NOT_EQUAL_TO_FLOAT_LVAR\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 浮 VAR 不等于浮 LVAR [#浮-var-不等于浮-lvar]\n\n<Opcode id=\"004B\" name=\"IS_FLOAT_VAR_NOT_EQUAL_TO_FLOAT_LVAR\">\n  用在 if：float VAR 是否不等于 float LVAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      004B IS_FLOAT_VAR_NOT_EQUAL_TO_FLOAT_LVAR\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      isFloatVarNotEqualToFloatLvar()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"IS_FLOAT_VAR_NOT_EQUAL_TO_FLOAT_LVAR\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 真则跳转 [#真则跳转]\n\n<Opcode id=\"004C\" name=\"GOTO_IF_TRUE\">\n  条件为真时跳转。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      004C GOTO_IF_TRUE\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      gotoIfTrue()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"GOTO_IF_TRUE\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 假则跳转 [#假则跳转]\n\n<Opcode id=\"004D\" name=\"GOTO_IF_FALSE\">\n  条件为假时跳转到标签。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      004D GOTO_IF_FALSE\n      in: label\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      gotoIfFalse(label)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"GOTO_IF_FALSE\", label)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 结束脚本 [#结束脚本]\n\n<Opcode id=\"004E\" name=\"TERMINATE_THIS_SCRIPT\">\n  结束当前脚本，不再继续执行。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      004E TERMINATE_THIS_SCRIPT\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      terminateThisScript()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"TERMINATE_THIS_SCRIPT\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 启动新脚本 [#启动新脚本]\n\n<Opcode id=\"004F\" name=\"START_NEW_SCRIPT\">\n  从指定标签启动新脚本。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      004F START_NEW_SCRIPT\n      in: label, arguments\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      startNewScript(label, arguments)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"START_NEW_SCRIPT\", label, arguments)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 子程序调用 [#子程序调用]\n\n<Opcode id=\"0050\" name=\"GOSUB\">\n  以子程序方式跳转到标签。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0050 GOSUB\n      in: label\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      gosub(label)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"GOSUB\", label)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 子程序返回 [#子程序返回]\n\n<Opcode id=\"0051\" name=\"RETURN\">\n  从当前子程序返回（0050）。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0051 RETURN\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      return()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"RETURN\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 取玩家坐标 [#取玩家坐标]\n\n<Opcode id=\"0054\" name=\"GET_PLAYER_COORDINATES\">\n  取玩家坐标。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0054 GET_PLAYER_COORDINATES\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      getPlayerCoordinates()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"GET_PLAYER_COORDINATES\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 设玩家坐标 [#设玩家坐标]\n\n<Opcode id=\"0055\" name=\"SET_PLAYER_COORDINATES\">\n  设玩家坐标。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0055 SET_PLAYER_COORDINATES\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      setPlayerCoordinates()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SET_PLAYER_COORDINATES\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 玩家在 2D 区域 [#玩家在-2d-区域]\n\n<Opcode id=\"0056\" name=\"IS_PLAYER_IN_AREA_2D\">\n  用在 if：玩家是否在 2D 区域。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0056 IS_PLAYER_IN_AREA_2D\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      isPlayerInArea2D()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"IS_PLAYER_IN_AREA_2D\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 玩家在 3D 区域 [#玩家在-3d-区域]\n\n<Opcode id=\"0057\" name=\"IS_PLAYER_IN_AREA_3D\">\n  用在 if：玩家是否在 3D 区域。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0057 IS_PLAYER_IN_AREA_3D\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      isPlayerInArea3D()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"IS_PLAYER_IN_AREA_3D\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 整 VAR 加整 VAR [#整-var-加整-var]\n\n<Opcode id=\"0058\" name=\"ADD_INT_VAR_TO_INT_VAR\">\n  把 int VAR 加到另一 int VAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0058 ADD_INT_VAR_TO_INT_VAR\n      in: int, int\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      addIntVarToIntVar(int, int)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"ADD_INT_VAR_TO_INT_VAR\", int, int)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 浮 VAR 加浮 VAR [#浮-var-加浮-var]\n\n<Opcode id=\"0059\" name=\"ADD_FLOAT_VAR_TO_FLOAT_VAR\">\n  把 float VAR 加到另一 float VAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0059 ADD_FLOAT_VAR_TO_FLOAT_VAR\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      addFloatVarToFloatVar(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"ADD_FLOAT_VAR_TO_FLOAT_VAR\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 整 LVAR 加整 LVAR [#整-lvar-加整-lvar]\n\n<Opcode id=\"005A\" name=\"ADD_INT_LVAR_TO_INT_LVAR\">\n  把 int LVAR 加到另一 int LVAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      005A ADD_INT_LVAR_TO_INT_LVAR\n      in: int, int\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      addIntLvarToIntLvar(int, int)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"ADD_INT_LVAR_TO_INT_LVAR\", int, int)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 浮 LVAR 加浮 LVAR [#浮-lvar-加浮-lvar]\n\n<Opcode id=\"005B\" name=\"ADD_FLOAT_LVAR_TO_FLOAT_LVAR\">\n  把 float LVAR 加到另一 float LVAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      005B ADD_FLOAT_LVAR_TO_FLOAT_LVAR\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      addFloatLvarToFloatLvar(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"ADD_FLOAT_LVAR_TO_FLOAT_LVAR\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 整 VAR 加整 LVAR [#整-var-加整-lvar]\n\n<Opcode id=\"005C\" name=\"ADD_INT_VAR_TO_INT_LVAR\">\n  把 int VAR 加到 int LVAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      005C ADD_INT_VAR_TO_INT_LVAR\n      in: int, int\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      addIntVarToIntLvar(int, int)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"ADD_INT_VAR_TO_INT_LVAR\", int, int)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 浮 VAR 加浮 LVAR [#浮-var-加浮-lvar]\n\n<Opcode id=\"005D\" name=\"ADD_FLOAT_VAR_TO_FLOAT_LVAR\">\n  把 float VAR 加到 float LVAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      005D ADD_FLOAT_VAR_TO_FLOAT_LVAR\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      addFloatVarToFloatLvar(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"ADD_FLOAT_VAR_TO_FLOAT_LVAR\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 整 LVAR 加整 VAR [#整-lvar-加整-var]\n\n<Opcode id=\"005E\" name=\"ADD_INT_LVAR_TO_INT_VAR\">\n  把 int LVAR 加到 int VAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      005E ADD_INT_LVAR_TO_INT_VAR\n      in: int, int\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      addIntLvarToIntVar(int, int)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"ADD_INT_LVAR_TO_INT_VAR\", int, int)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 浮 LVAR 加浮 VAR [#浮-lvar-加浮-var]\n\n<Opcode id=\"005F\" name=\"ADD_FLOAT_LVAR_TO_FLOAT_VAR\">\n  把 float LVAR 加到 float VAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      005F ADD_FLOAT_LVAR_TO_FLOAT_VAR\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      addFloatLvarToFloatVar(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"ADD_FLOAT_LVAR_TO_FLOAT_VAR\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 整 VAR 减整 VAR [#整-var-减整-var]\n\n<Opcode id=\"0060\" name=\"SUB_INT_VAR_FROM_INT_VAR\">\n  从 int VAR 减去 int VAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0060 SUB_INT_VAR_FROM_INT_VAR\n      in: int, int\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      subIntVarFromIntVar(int, int)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SUB_INT_VAR_FROM_INT_VAR\", int, int)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 浮 VAR 减浮 VAR [#浮-var-减浮-var]\n\n<Opcode id=\"0061\" name=\"SUB_FLOAT_VAR_FROM_FLOAT_VAR\">\n  从 float VAR 减去 float VAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0061 SUB_FLOAT_VAR_FROM_FLOAT_VAR\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      subFloatVarFromFloatVar(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SUB_FLOAT_VAR_FROM_FLOAT_VAR\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 整 LVAR 减整 LVAR [#整-lvar-减整-lvar]\n\n<Opcode id=\"0062\" name=\"SUB_INT_LVAR_FROM_INT_LVAR\">\n  从 int LVAR 减去 int LVAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0062 SUB_INT_LVAR_FROM_INT_LVAR\n      in: int, int\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      subIntLvarFromIntLvar(int, int)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SUB_INT_LVAR_FROM_INT_LVAR\", int, int)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 浮 LVAR 减浮 LVAR [#浮-lvar-减浮-lvar]\n\n<Opcode id=\"0063\" name=\"SUB_FLOAT_LVAR_FROM_FLOAT_LVAR\">\n  从 float LVAR 减去 float LVAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0063 SUB_FLOAT_LVAR_FROM_FLOAT_LVAR\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      subFloatLvarFromFloatLvar(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SUB_FLOAT_LVAR_FROM_FLOAT_LVAR\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 整 LVAR 减整 VAR [#整-lvar-减整-var]\n\n<Opcode id=\"0064\" name=\"SUB_INT_VAR_FROM_INT_LVAR\">\n  从 int LVAR 减去 int VAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\