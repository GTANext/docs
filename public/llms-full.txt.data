OAT_VAR\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 时基加值到浮 VAR [#时基加值到浮-var]\n\n<Opcode id=\"0078\" name=\"ADD_TIMED_VAL_TO_FLOAT_VAR\">\n  用上一帧 delta 时间乘指定值再加到指定变量。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0078 ADD_TIMED_VAL_TO_FLOAT_VAR\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      addTimedValToFloatVar(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"ADD_TIMED_VAL_TO_FLOAT_VAR\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 时基加值到浮 LVAR [#时基加值到浮-lvar]\n\n<Opcode id=\"0079\" name=\"ADD_TIMED_VAL_TO_FLOAT_LVAR\">\n  用上一帧 delta 时间乘指定值再加到指定变量。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0079 ADD_TIMED_VAL_TO_FLOAT_LVAR\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      addTimedValToFloatLvar(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"ADD_TIMED_VAL_TO_FLOAT_LVAR\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 时基浮 VAR 加浮 VAR [#时基浮-var-加浮-var]\n\n<Opcode id=\"007A\" name=\"ADD_TIMED_FLOAT_VAR_TO_FLOAT_VAR\">\n  用上一帧 delta 时间乘全局浮点变量再加到该全局变量。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      007A ADD_TIMED_FLOAT_VAR_TO_FLOAT_VAR\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      addTimedFloatVarToFloatVar(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"ADD_TIMED_FLOAT_VAR_TO_FLOAT_VAR\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 时基浮 LVAR 加浮 LVAR [#时基浮-lvar-加浮-lvar]\n\n<Opcode id=\"007B\" name=\"ADD_TIMED_FLOAT_LVAR_TO_FLOAT_LVAR\">\n  用上一帧 delta 时间乘局部浮点变量再加到该局部变量。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      007B ADD_TIMED_FLOAT_LVAR_TO_FLOAT_LVAR\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      addTimedFloatLvarToFloatLvar(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"ADD_TIMED_FLOAT_LVAR_TO_FLOAT_LVAR\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 时基浮 VAR 加浮 LVAR [#时基浮-var-加浮-lvar]\n\n<Opcode id=\"007C\" name=\"ADD_TIMED_FLOAT_VAR_TO_FLOAT_LVAR\">\n  用上一帧 delta 时间乘全局浮点变量再加到局部变量。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      007C ADD_TIMED_FLOAT_VAR_TO_FLOAT_LVAR\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      addTimedFloatVarToFloatLvar(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"ADD_TIMED_FLOAT_VAR_TO_FLOAT_LVAR\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 时基浮 LVAR 加浮 VAR [#时基浮-lvar-加浮-var]\n\n<Opcode id=\"007D\" name=\"ADD_TIMED_FLOAT_LVAR_TO_FLOAT_VAR\">\n  用上一帧 delta 时间乘局部浮点变量再加到全局变量。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      007D ADD_TIMED_FLOAT_LVAR_TO_FLOAT_VAR\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      addTimedFloatLvarToFloatVar(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"ADD_TIMED_FLOAT_LVAR_TO_FLOAT_VAR\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 时基从浮 VAR 减值 [#时基从浮-var-减值]\n\n<Opcode id=\"007E\" name=\"SUB_TIMED_VAL_FROM_FLOAT_VAR\">\n  用上一帧 delta 时间乘指定浮点值再从全局变量减去。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      007E SUB_TIMED_VAL_FROM_FLOAT_VAR\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      subTimedValFromFloatVar(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SUB_TIMED_VAL_FROM_FLOAT_VAR\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 时基从浮 LVAR 减值 [#时基从浮-lvar-减值]\n\n<Opcode id=\"007F\" name=\"SUB_TIMED_VAL_FROM_FLOAT_LVAR\">\n  用上一帧 delta 时间乘指定值再从局部变量减去。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      007F SUB_TIMED_VAL_FROM_FLOAT_LVAR\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      subTimedValFromFloatLvar(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SUB_TIMED_VAL_FROM_FLOAT_LVAR\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 时基浮 VAR 减浮 VAR [#时基浮-var-减浮-var]\n\n<Opcode id=\"0080\" name=\"SUB_TIMED_FLOAT_VAR_FROM_FLOAT_VAR\">\n  用上一帧 delta 时间乘全局变量再从该全局变量减去。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0080 SUB_TIMED_FLOAT_VAR_FROM_FLOAT_VAR\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      subTimedFloatVarFromFloatVar(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SUB_TIMED_FLOAT_VAR_FROM_FLOAT_VAR\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 时基浮 LVAR 减浮 LVAR [#时基浮-lvar-减浮-lvar]\n\n<Opcode id=\"0081\" name=\"SUB_TIMED_FLOAT_LVAR_FROM_FLOAT_LVAR\">\n  用上一帧 delta 时间乘局部变量再从该局部变量减去。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0081 SUB_TIMED_FLOAT_LVAR_FROM_FLOAT_LVAR\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      subTimedFloatLvarFromFloatLvar(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SUB_TIMED_FLOAT_LVAR_FROM_FLOAT_LVAR\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 时基浮 VAR 减浮 LVAR [#时基浮-var-减浮-lvar]\n\n<Opcode id=\"0082\" name=\"SUB_TIMED_FLOAT_VAR_FROM_FLOAT_LVAR\">\n  用上一帧 delta 时间乘全局变量再从局部变量减去。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0082 SUB_TIMED_FLOAT_VAR_FROM_FLOAT_LVAR\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      subTimedFloatVarFromFloatLvar(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SUB_TIMED_FLOAT_VAR_FROM_FLOAT_LVAR\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 时基浮 LVAR 减浮 VAR [#时基浮-lvar-减浮-var]\n\n<Opcode id=\"0083\" name=\"SUB_TIMED_FLOAT_LVAR_FROM_FLOAT_VAR\">\n  用帧 delta（距上一帧毫秒）乘指定局部变量中的浮点值。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0083 SUB_TIMED_FLOAT_LVAR_FROM_FLOAT_VAR\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      subTimedFloatLvarFromFloatVar(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SUB_TIMED_FLOAT_LVAR_FROM_FLOAT_VAR\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 整 VAR 赋整 VAR [#整-var-赋整-var]\n\n<Opcode id=\"0084\" name=\"SET_VAR_INT_TO_VAR_INT\">\n  把 int VAR 设为另一 VAR 的值。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0084 SET_VAR_INT_TO_VAR_INT\n      in: int, int\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      setVarIntToVarInt(int, int)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SET_VAR_INT_TO_VAR_INT\", int, int)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 整 LVAR 赋整 LVAR [#整-lvar-赋整-lvar]\n\n<Opcode id=\"0085\" name=\"SET_LVAR_INT_TO_LVAR_INT\">\n  把 int LVAR 设为另一 LVAR 的值。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0085 SET_LVAR_INT_TO_LVAR_INT\n      in: int, int\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      setLvarIntToLvarInt(int, int)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SET_LVAR_INT_TO_LVAR_INT\", int, int)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 浮 VAR 赋浮 VAR [#浮-var-赋浮-var]\n\n<Opcode id=\"0086\" name=\"SET_VAR_FLOAT_TO_VAR_FLOAT\">\n  把 float VAR 设为另一 VAR 的值。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0086 SET_VAR_FLOAT_TO_VAR_FLOAT\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      setVarFloatToVarFloat(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SET_VAR_FLOAT_TO_VAR_FLOAT\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 浮 LVAR 赋浮 LVAR [#浮-lvar-赋浮-lvar]\n\n<Opcode id=\"0087\" name=\"SET_LVAR_FLOAT_TO_LVAR_FLOAT\">\n  把 float LVAR 设为另一 LVAR 的值。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0087 SET_LVAR_FLOAT_TO_LVAR_FLOAT\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      setLvarFloatToLvarFloat(float, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SET_LVAR_FLOAT_TO_LVAR_FLOAT\", float, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 浮 VAR 赋浮 LVAR [#浮-var-赋浮-lvar]\n\n<Opcode id=\"0088\" name=\"SET_VAR_FLOAT_TO_LVAR_FLOAT\">\n  把 float VAR 设为 LVAR 的值。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0088 SET_VAR_FLOAT_TO_LVAR_FLOAT\n      in: float, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      setVarFloatToLvarFloat(float, float)