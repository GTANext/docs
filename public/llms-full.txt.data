/CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 整 LVAR 赋整 VAR [#整-lvar-赋整-var]\n\n<Opcode id=\"008B\" name=\"SET_LVAR_INT_TO_VAR_INT\">\n  把 int LVAR 设为 VAR 的值。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      008B SET_LVAR_INT_TO_VAR_INT\n      in: int, int\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      setLvarIntToVarInt(int, int)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SET_LVAR_INT_TO_VAR_INT\", int, int)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 整 VAR 截断自浮 VAR [#整-var-截断自浮-var]\n\n<Opcode id=\"008C\" name=\"CSET_VAR_INT_TO_VAR_FLOAT\">\n  把第二个全局变量浮点向下取整为整数写入第一个全局变量。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      008C CSET_VAR_INT_TO_VAR_FLOAT\n      in: int, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      csetVarIntToVarFloat(int, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"CSET_VAR_INT_TO_VAR_FLOAT\", int, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 浮 VAR 转自整 VAR [#浮-var-转自整-var]\n\n<Opcode id=\"008D\" name=\"CSET_VAR_FLOAT_TO_VAR_INT\">\n  把第二个全局变量整数转为浮点写入第一个全局变量。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      008D CSET_VAR_FLOAT_TO_VAR_INT\n      in: float, int\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      csetVarFloatToVarInt(float, int)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"CSET_VAR_FLOAT_TO_VAR_INT\", float, int)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 整 LVAR 截断自浮 VAR [#整-lvar-截断自浮-var]\n\n<Opcode id=\"008E\" name=\"CSET_LVAR_INT_TO_VAR_FLOAT\">\n  把全局变量浮点向下取整为整数写入局部变量。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      008E CSET_LVAR_INT_TO_VAR_FLOAT\n      in: int, float\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      csetLvarIntToVarFloat(int, float)\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"CSET_LVAR_INT_TO_VAR_FLOAT\", int, float)\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 浮 LVAR 转自整 VAR [#浮-lvar-转自整-var]\n\n<Opcode id=\"008F\" name=\"CSET_LVAR_FLOAT_TO_VAR_INT\">\n  把全局变量整数转为浮点写入局部变量。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n 