eBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      00EA LOCATE_PLAYER_ON_FOOT_CHAR_2D\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      locatePlayerOnFootChar2D()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"LOCATE_PLAYER_ON_FOOT_CHAR_2D\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 定位玩家相对人物车内 2D [#定位玩家相对人物车内-2d]\n\n<Opcode id=\"00EB\" name=\"LOCATE_PLAYER_IN_CAR_CHAR_2D\">\n  LOCATE\\_PLAYER\\_IN\\_CAR\\_CHAR\\_2D。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      00EB LOCATE_PLAYER_IN_CAR_CHAR_2D\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      locatePlayerInCarChar2D()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"LOCATE_PLAYER_IN_CAR_CHAR_2D\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 定位玩家任意方式 3D [#定位玩家任意方式-3d]\n\n<Opcode id=\"00F5\" name=\"LOCATE_PLAYER_ANY_MEANS_3D\">\n  LOCATE\\_PLAYER\\_ANY\\_MEANS\\_3D。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      00F5 LOCATE_PLAYER_ANY_MEANS_3D\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      locat