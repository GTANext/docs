bject()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SET_COLL_OBJ_DESTROY_OBJECT\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 碰撞对象摧毁车 [#碰撞对象摧毁车]\n\n<Opcode id=\"026D\" name=\"SET_COLL_OBJ_DESTROY_CAR\">\n  SET\\_COLL\\_OBJ\\_DESTROY\\_CAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      026D SET_COLL_OBJ_DESTROY_CAR\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      setCollObjDestroyCar()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SET_COLL_OBJ_DESTROY_CAR\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 碰撞对象步行去区域 [#碰撞对象步行去区域]\n\n<Opcode id=\"026E\" name=\"SET_COLL_OBJ_GOTO_AREA_ON_FOOT\">\n  SET\\_COLL\\_OBJ\\_GOTO\\_AREA\\_ON\\_FOOT。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      026E SET_COLL_OBJ_GOTO_AREA_ON_FOOT\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      setCollObjGotoAreaOnFoot()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SET_COLL_OBJ_GOTO_AREA_ON_FOOT\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 碰撞对象车内去区域 [#碰撞对象车内去区域]\n\n<Opcode id=\"026F\" name=\"SET_COLL_OBJ_GOTO_AREA_IN_CAR\">\n  SET\\_COLL\\_OBJ\\_GOTO\\_AREA\\_IN\\_CAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      026F SET_COLL_OBJ_GOTO_AREA_IN_CAR\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      setCollObjGotoAreaInCar()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SET_COLL_OBJ_GOTO_AREA_IN_CAR\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 碰撞对象步行跟车带偏移 [#碰撞对象步行跟车带偏移]\n\n<Opcode id=\"0270\" name=\"SET_COLL_OBJ_FOLLOW_CAR_ON_FOOT_WITH_OFFSET\">\n  SET\\_COLL\\_OBJ\\_FOLLOW\\_CAR\\_ON\\_FOOT\\_WITH\\_OFFSET。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0270 SET_COLL_OBJ_FOLLOW_CAR_ON_FOOT_WITH_OFFSET\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      setCollObjFollowCarOnFootWithOffset()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SET_COLL_OBJ_FOLLOW_CAR_ON_FOOT_WITH_OFFSET\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 碰撞对象守卫攻击 [#碰撞对象守卫攻击]\n\n<Opcode id=\"0271\" name=\"SET_COLL_OBJ_GUARD_ATTACK\">\n  SET\\_COLL\\_OBJ\\_GUARD\\_ATTACK。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0271 SET_COLL_OBJ_GUARD_ATTACK\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      setCollObjGuardAttack()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SET_COLL_OBJ_GUARD_ATTACK\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 碰撞对象沿路线 [#碰撞对象沿路线]\n\n<Opcode id=\"0272\" name=\"SET_COLL_OBJ_FOLLOW_ROUTE\">\n  SET\\_COLL\\_OBJ\\_FOLLOW\\_ROUTE。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0272 SET_COLL_OBJ_FOLLOW_ROUTE\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      setCollObjFollowRoute()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SET_COLL_OBJ_FOLLOW_ROUTE\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 碰撞对象步行去坐标 [#碰撞对象步行去坐标]\n\n<Opcode id=\"0273\" name=\"SET_COLL_OBJ_GOTO_COORD_ON_FOOT\">\n  SET\\_COLL\\_OBJ\\_GOTO\\_COORD\\_ON\\_FOOT。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0273 SET_COLL_OBJ_GOTO_COORD_ON_FOOT\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      setCollObjGotoCoordOnFoot()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SET_COLL_OBJ_GOTO_COORD_ON_FOOT\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 碰撞对象车内去坐标 [#碰撞对象车内去坐标]\n\n<Opcode id=\"0274\" name=\"SET_COLL_OBJ_GOTO_COORD_IN_CAR\">\n  SET\\_COLL\\_OBJ\\_GOTO\\_COORD\\_IN\\_CAR。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0274 SET_COLL_OBJ_GOTO_COORD_IN_CAR\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      setCollObjGotoCoordInCar()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SET_COLL_OBJ_GOTO_COORD_IN_CAR\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 碰撞对象跑向区域 [#碰撞对象跑向区域]\n\n<Opcode id=\"0275\" name=\"SET_COLL_OBJ_RUN_TO_AREA\">\n  SET\\_COLL\\_OBJ\\_RUN\\_TO\\_AREA。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0275 SET_COLL_OBJ_RUN_TO_