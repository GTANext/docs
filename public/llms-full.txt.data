kTabs>\n</Opcode>\n\n## 帮派行人模型偏好 [#帮派行人模型偏好]\n\n<Opcode id=\"0410\" name=\"SET_GANG_PED_MODEL_PREFERENCE\">\n  SET\\_GANG\\_PED\\_MODEL\\_PREFERENCE。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0410 SET_GANG_PED_MODEL_PREFERENCE\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      setGangPedModelPreference()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SET_GANG_PED_MODEL_PREFERENCE\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 人物用行人节点寻路 [#人物用行人节点寻路]\n\n<Opcode id=\"0411\" name=\"SET_CHAR_USE_PEDNODE_SEEK\">\n  SET\\_CHAR\\_USE\\_PEDNODE\\_SEEK。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger value=\"OP\">\n        OP\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Lua\">\n        Lua\n      </CodeBlockTabsTrigger>\n\n      <CodeBlockTabsTrigger value=\"Redux\">\n        Redux\n      </CodeBlockTabsTrigger>\n    </CodeBlockTabsList>\n\n    <CodeBlockTab value=\"OP\">\n      ```text\n      0411 SET_CHAR_USE_PEDNODE_SEEK\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Lua\">\n      ```lua\n      setCharUsePednodeSeek()\n      ```\n    </CodeBlockTab>\n\n    <CodeBlockTab value=\"Redux\">\n      ```js\n      native(\"SET_CHAR_USE_PEDNODE_SEEK\")\n      ```\n    </CodeBlockTab>\n  </CodeBlockTabs>\n</Opcode>\n\n## 开关载具武器 [#开关载具武器]\n\n<Opcode id=\"0412\" name=\"SWITCH_VEHICLE_WEAPONS\">\n  SWITCH\\_VEHICLE\\_WEAPONS。\n\n  <CodeBlockTabs defaultValue=\"OP\">\n    <CodeBlockTabsList>\n      <CodeBlockTabsTrigger